# SIP Trunk Configuration
SIP_HOST=sip.example.com
SIP_FAILOVER_HOST=
SIP_PORT=5060
SIP_USER=02XXXXXXX
SIP_PASSWORD=your_sip_password_here
SIP_MAX_LINES=5
PORT=3000

# J.A.R.V.I.S Voice Agent (Integrated in ./jarvis)
JARVIS_URL=http://127.0.0.1:7861
AUTO_ANSWER_AI=true

# Ollama Cloud Post-Call QA Analyzer (DeepSeek)
OLLAMA_BASE_URL=https://ollama.com
OLLAMA_MODEL=deepseek-v4.1-flash
OLLAMA_API_KEY=your_ollama_cloud_api_key_here

# Admin Access Control (Google Sign-In; supports comma-separated emails in ADMIN_EMAIL / ADMIN_EMAILS)
ADMIN_EMAIL=admin@example.com
# Optional: comma-separated list of additional admin emails
ADMIN_EMAILS=admin@example.com,staff@example.com
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
AUTH_COOKIE_SECRET=replace_with_random_64_char_hex_secret

# Embedded BC Brain Hybrid Search (PostgreSQL 18 + pgvector + Local Ollama bge-m3)
BRAIN_PG_HOST=127.0.0.1
BRAIN_PG_PORT=5446
BRAIN_PG_DB=bccallcenter_brain
BRAIN_PG_USER=bcbrain
BRAIN_PG_PASSWORD=replace_with_strong_local_pg_password
BRAIN_PG_ENABLED=true
BRAIN_EMBED_URL=http://127.0.0.1:11434/api/embed
BRAIN_EMBED_MODEL=bge-m3:latest
