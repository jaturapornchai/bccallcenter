# LiveKit Server Connection
LIVEKIT_URL=ws://127.0.0.1:7880
LIVEKIT_API_KEY=lk_bc_callcenter_key
LIVEKIT_API_SECRET=<replace-with-local-secret>

# Inbound SIP Host Port (5062 เพื่อไม่ชนพอร์ต 5060 ของระบบเดิม; ใช้ 5060 เมื่อขึ้น production เดี่ยว)
LK_SIP_HOST_PORT=5062

# STT Configuration (local_whisper | openai_compat)
STT_PROVIDER=local_whisper
STT_MODEL_PATH=../jarvis/models/faster-whisper-large-v3-turbo-th
STT_DEVICE=cuda
STT_COMPUTE_TYPE=float16
# กรณีใช้ openai_compat (เช่น Faster-Whisper HTTP / vLLM)
STT_API_BASE_URL=http://127.0.0.1:8001/v1
STT_API_KEY=local-key
STT_API_MODEL=biodatlab/whisper-th-large-v3-combined

# LLM Brain Configuration (Ollama Cloud DeepSeek หรือ Local Ollama Typhoon 2)
LLM_BASE_URL=https://ollama.com/v1
LLM_MODEL=deepseek-v4.1-flash
LLM_API_KEY=your_ollama_cloud_api_key_here
# ตัวอย่างสลับไปใช้ Typhoon 2 บน Local Ollama:
# LLM_BASE_URL=http://127.0.0.1:11434/v1
# LLM_MODEL=scb10x/typhoon2
# LLM_API_KEY=ollama

# TTS Configuration (openai_compat | f5_http | pythaitts)
TTS_PROVIDER=f5_http
TTS_HTTP_URL=http://127.0.0.1:8002/tts
TTS_REF_AUDIO=../jarvis/ref_audio.wav
TTS_SAMPLE_RATE=24000
TTS_VOICE=jarvis-th

# Call Center Transfer Destinations (SIP URI หรือเบอร์ต่อภายใน)
TRANSFER_OPERATOR_URI=sip:100@asterisk-registrar:5060
TRANSFER_SALES_URI=sip:101@asterisk-registrar:5060
TRANSFER_SUPPORT_URI=sip:102@asterisk-registrar:5060

# Shared Call Memory & Knowledge Base
CALL_MEMORY_PATH=../data/call-memory.json
TICKETS_PATH=../data/tickets.json
BC_BRAIN_MCP_URL=https://brain.bcsmethai.com/mcp

# Barge-in & Turn-Taking Tuning (วินาที)
BARGE_MIN_SPEECH_S=0.25
ENDPOINT_MIN_DELAY_S=0.45
ENDPOINT_MAX_DELAY_S=1.80
